# D025 special-event grammar on visible page-2 rows.
340 btndown 2
341 btnup 2    # REST at step 17
350 btn 3      # TIE at step 18
360 btndown 2
361 btn 3      # OFF at step 19
362 btnup 2    # must not add REST
370 keys 0x800 # E4 / MIDI 64 at step 20
371 keys 0

# PLAY while STEP REC is active exits STEP REC before resuming playback.
500 btn 12

# Built-in host shot at 1000 ms captures the integrated tracker state.
1100 btn 8  # HOME

# Built-in host shot at 3000 ms captures HOME after the complete workflow.
3200 end
